# GhostTerminal AI Environment Configuration
# Copy this file to .env for local overrides (never commit .env)

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Security / CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Planned Open-Weight Model (Part 2 preview - no weights downloaded in Part 1)
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
MODEL_DEVICE=cpu
